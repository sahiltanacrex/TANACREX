<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="mrp_production_workorder_inherit_tree_view" model="ir.ui.view">
    <field name="name">mrp.production.work.order.inherit.tree</field>
    <field name="model">mrp.workorder</field>
    <field name="inherit_id" ref="mrp.mrp_production_workorder_tree_view"/>
    <field name="arch" type="xml">
      <field name="name" position="before">
        <field name="priority_production_id"/>
      </field>
      <field name="production_id" position="after">
        <field name="partner_production_id"/>
        <field name="product_qty_production_id"/>
      </field>
    </field>
  </record>
</odoo>