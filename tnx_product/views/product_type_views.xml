<?xml version="1.0" encoding="utf-8"?>
<odoo> 
    <record id="view_product_type_view" model="ir.ui.view">
        <field name="name">product_type.form</field>
        <field name="model">product.type</field>
        <field name="arch" type="xml">
            <form string="Type de produit">
                <sheet>
                    <group>
                        <group>

                            <field name="code" />
                            <field name="name" />
                        </group>
                    </group>
                    
                </sheet>
            </form>
        </field>
    </record>
    <record id="product_type_tree" model="ir.ui.view">
        <field name="name">product_type.tree</field>
        <field name="model">product.type</field>
        <field name="arch" type="xml">
            <tree string="Type de produit">
                <field name="code" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_product_type">
        <field name="name">Type de produit</field>
        <field name="res_model">product.type</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="product_type_menu" name="Type de produit" parent="sale.menu_sale_config" action="action_product_type" sequence="6"/>

</odoo>
